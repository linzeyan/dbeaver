# Names, ports, images and passwords for the test servers.
#
# Read by two things that both parse `NAME=value` natively: `docker compose`
# picks this up on its own, and the Makefile `include`s it. That is the whole
# reason the file exists — publishing a port and checking that port are done by
# different tools, and a number written down twice is a number that will one day
# disagree with itself.
#
# Nothing secret belongs here. These passwords are fixtures: they are in the
# repository, they guard containers bound to the loopback address, and they are
# printed in full by the targets that use them. A credential that matters must
# not be added to this file.

COMPOSE_PROJECT_NAME=dbclient

# Ports are all non-default, so that a locally installed PostgreSQL or MySQL and
# a test container can be up at the same time without either one having to move.

# The benchmark database, and the one every app-level target connects to.
PG_CONTAINER=pg-bench
PG_PORT=55432
PG_IMAGE=postgres:17

# PostgreSQL again, with TLS on and plaintext refused. Its own container rather
# than a flag on the one above, because the whole point of it is that a
# connection asking for `sslmode=disable` is turned away — and that is how every
# other test in this tree reaches the benchmark database.
PGTLS_CONTAINER=pg-tls
PGTLS_PORT=55434

# MongoDB, for the driver's own tests and for its pass through the shared
# contract. It holds no benchmark data — every test seeds and drops the database
# it uses, so this container needs nothing done to it beyond being up.
MONGO_CONTAINER=mongo-test
MONGO_PORT=57017
MONGO_IMAGE=mongo:7

REDIS_CONTAINER=redis-test
REDIS_PORT=56379
REDIS_IMAGE=redis:7

# Cassandra takes a long time to start, and is the reason the memory limits in
# docker-compose.yml are not decoration: left to itself it sized a heap from the
# host's 16GB and sat on 8.6GB of it while idle.
CASSANDRA_CONTAINER=cassandra-test
CASSANDRA_PORT=59042
CASSANDRA_IMAGE=cassandra:5

# Trino, the one database of the REST set that can be run at all without a cloud
# account. It needs no seeding: the `tpch` catalog generates its data on demand,
# so `tpch.sf1.orders` is a million and a half rows that exist because they were
# asked for — which also makes it the only server here whose fixture cannot
# drift.
TRINO_CONTAINER=trino-test
TRINO_PORT=58080
TRINO_IMAGE=trinodb/trino:latest

# A third-party Arrow Flight SQL server, which is the only kind worth testing
# against: a server written here would agree with this client by construction.
# The image is the Arrow project's own example server over DuckDB, and it ships
# a small TPC-H database inside it — so, like Trino, it needs no seeding and its
# fixture cannot drift.
FLIGHTSQL_CONTAINER=flightsql-test
FLIGHTSQL_PORT=51337
FLIGHTSQL_IMAGE=voltrondata/flight-sql:latest
FLIGHTSQL_PASSWORD=flight

# The two databases that exist to prove protocol compatibility rather than to be
# supported: they are read by the PostgreSQL driver and no code of their own, so
# what these containers test is that the claim is true.
COCKROACH_CONTAINER=cockroach-test
COCKROACH_PORT=56257
COCKROACH_IMAGE=cockroachdb/cockroach:v24.1.5
GREPTIME_CONTAINER=greptime-test
GREPTIME_PORT=54003
GREPTIME_IMAGE=greptime/greptimedb:latest

# The same argument on the other protocol: TiDB and StarRocks are read by the
# MySQL driver and no code of their own. Both take `root` with no password,
# which is their own default rather than a setting chosen here.
TIDB_CONTAINER=tidb-test
TIDB_PORT=54000
TIDB_IMAGE=pingcap/tidb:latest

# StarRocks brings up a frontend and a backend inside one container and will not
# answer until both have registered with each other, which is why it gets both
# the largest budget here and the longest wait.
STARROCKS_CONTAINER=starrocks-test
STARROCKS_PORT=59030
STARROCKS_IMAGE=starrocks/allin1-ubuntu:latest

# MySQL. No seeding here: the driver's own tests build the fixture themselves,
# because a fixture kept in a Makefile drifts away from the assertions that read
# it and nobody notices until one of them fails for the wrong reason.
MYSQL_CONTAINER=mysql-test
MYSQL_PORT=53306
MYSQL_IMAGE=mysql:8

# SQL Server. Microsoft publishes no ARM64 build — not for 2019, 2022 or 2025 —
# so on Apple silicon this runs under Rosetta. Azure SQL Edge is the usual ARM64
# substitute and is the wrong fixture: it is a reduced engine, and half of what
# the tests exercise is the full `sys.*` surface and the CLR types it does not
# have.
MSSQL_CONTAINER=mssql-test
MSSQL_PORT=51433
MSSQL_PASSWORD=Str0ng!Passw0rd
MSSQL_IMAGE=mcr.microsoft.com/mssql/server:2022-latest

# ClickHouse, whose fixture is a seed script rather than a few inserts: the
# driver's argument is about types, so the table has to contain the types it
# argues about. Two ports because the native protocol sits beside the HTTP one.
CLICKHOUSE_CONTAINER=clickhouse-test
CLICKHOUSE_PORT=58123
CLICKHOUSE_NATIVE_PORT=59000
CLICKHOUSE_IMAGE=clickhouse/clickhouse-server:24

# An SSH server, which is the one container here that holds no data: it exists
# so that the tunnel support has something to tunnel through, and what it
# forwards to is the benchmark PostgreSQL above.
SSH_CONTAINER=ssh-test
SSH_PORT=52222
SSH_IMAGE=lscr.io/linuxserver/openssh-server:latest
SSH_USER=bench
SSH_PASSWORD=bench
